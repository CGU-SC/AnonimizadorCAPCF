# Segredo do ambiente de desenvolvimento — nunca versionado.
# O .env.example (com só os nomes das variáveis) fica de fora desta lista de propósito.
.env

# Documentos de exemplo com CPF real — nunca podem entrar no histórico,
# mesmo que a pasta volte a existir depois.
Exemplos/

# Artefatos gerados (instalador, .exe final) — nascem do código, não se editam à mão.
builds/

# O instalador do Tesseract, que fica ao lado do programa para o botão
# "instalar agora" (spec 002). É programa de terceiros, vem do site dele no dia
# da entrega - não é código deste projeto.
instaladores/

# A marca que o abrir-sem-motor.bat e o abrir-sem-portugues.bat criam para
# fingir que o Tesseract não está pronto. Existe só enquanto a simulação dura.
abrir/.motor-escondido

# Saída padrão do PyInstaller ao gerar o executável. A receita dele (o .spec em
# empacotar/) fica DENTRO do histórico: é código do projeto, e sem ela a
# próxima versão seria montada de outro jeito (entrega de 23/09/2026).
build/
dist/

# Ambiente virtual do Python — cada máquina cria o seu com `pip install -r requirements.txt`.
.venv/

# Arquivos que o Python gera sozinho ao rodar.
__pycache__/
*.pyc

# Arquivos de configuração do editor/sistema, específicos de cada máquina.
.vscode/
Thumbs.db
